FROM debian:bookworm-slim

ARG ARDUINO_CLI_VERSION=1.4.1
ARG RP2040_INDEX_URL=https://github.com/earlephilhower/arduino-pico/releases/download/global/package_rp2040_index.json
ARG ESP32_INDEX_URL=https://espressif.github.io/arduino-esp32/package_esp32_index.json

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-serial git \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/arduino/arduino-cli/releases/download/v${ARDUINO_CLI_VERSION}/arduino-cli_${ARDUINO_CLI_VERSION}_Linux_64bit.tar.gz" \
  | tar -xz -C /usr/local/bin arduino-cli

# Cores are installed into a world-readable location so any --user works.
ENV ARDUINO_DIRECTORIES_DATA=/opt/arduino15 \
    ARDUINO_DIRECTORIES_USER=/tmp/arduino-user

COPY scripts/cores.txt /tmp/cores.txt
RUN arduino-cli config add board_manager.additional_urls "${RP2040_INDEX_URL}" \
 && arduino-cli core update-index \
 && grep -vE '^\s*(#|$)' /tmp/cores.txt | xargs arduino-cli core install \
 && chmod -R a+rX /opt/arduino15

WORKDIR /work
ENTRYPOINT ["/work/scripts/tools/test-compile.sh"]
