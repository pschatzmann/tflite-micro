# Upstream tflite-micro ref (tag, branch or commit) the library is generated from.
UPSTREAM_REF=main
# Reference kernels by default: portable across all Arduino architectures.
TARGET=cortex_m_generic

# 
# OPTIMIZED_KERNEL_DIR
# esp_nn, cmsis_nn
# 
OPTIMIZED_KERNEL_DIR=
TARGET_ARCH=project_generation
