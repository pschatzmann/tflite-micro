# Upstream tflite-micro ref (tag, branch or commit) the library is generated from.
UPSTREAM_REF=main
# Reference kernels by default: portable across all Arduino architectures.
TARGET=cortex_m_generic

# OPTIMIZED_KERNEL_DIR replaces the reference kernels for every board (esp_nn,
# cmsis_nn). Keep it empty: optimized kernels are merged in below instead.
OPTIMIZED_KERNEL_DIR=

# Optimized kernel variants merged in next to the reference kernels and selected
# per board at compile time (see scripts/templates/src/tensorflow/lite/micro/
# arduino_cmsis_nn_config.h). Supported: cmsis_nn (Arm cores with DSP or MVE).
# Empty = reference kernels only.
MERGE_KERNEL_DIRS="cmsis_nn"
TARGET_ARCH=project_generation
